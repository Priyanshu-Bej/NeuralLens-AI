# Copy to .env (git-ignored) and fill in. Loaded with --dart-define-from-file=.env.

# Gemini (Google AI Studio: https://aistudio.google.com/apikey).
# Development builds only: the key is compiled into the APK.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Glasses Speaker Cue Agent server (agents/glasses-speaker-cue-agent in
# gdgcblr/open-source-agents). When both are set, new scripts come from the agent.
# Use the laptop's IP on a shared network, e.g. http://192.168.1.20:8080.
# AGENT_TOKEN must match the server's AGENT_TOKEN. Compiled into the APK: dev only.
AGENT_URL=
AGENT_TOKEN=

# Meta Wearables DAT. Developer Mode uses 0; release values come from the
# Wearables Developer Center.
MWDAT_APPLICATION_ID=0
MWDAT_CLIENT_TOKEN=0
