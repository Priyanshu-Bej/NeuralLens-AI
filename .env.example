# Copy to .env (git-ignored) and fill in. Loaded with --dart-define-from-file=.env.

# Gemini (Google AI Studio: https://aistudio.google.com/apikey).
# Development builds only: the key is compiled into the APK.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Meta Wearables DAT. Developer Mode uses 0; release values come from the
# Wearables Developer Center.
MWDAT_APPLICATION_ID=0
MWDAT_CLIENT_TOKEN=0
